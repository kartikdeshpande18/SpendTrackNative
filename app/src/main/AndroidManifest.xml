<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_spendtrack"
        android:label="SpendTrack"
        android:roundIcon="@mipmap/ic_spendtrack_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SpendTrack">

        <activity
            android:name=".MainActivity"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <receiver
            android:name=".widget.SpendTrackWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_spendtrack_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/spendtrack_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.SpendTrackQuickActionWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_quick_actions_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/spendtrack_quick_action_widget_info" />
        </receiver>

    </application>

</manifest>
